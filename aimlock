<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,user-scalable=no">
<title>Aimlock Nguyendat</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
}

body {
    min-height: 100vh;
    font-family: Arial, sans-serif;
    background:
        radial-gradient(circle at top, #16244a 0%, #080b14 45%, #030408 100%);
    color: white;
    padding: 22px 15px 40px;
}

.container {
    width: 100%;
    max-width: 480px;
    margin: auto;
}

.header {
    text-align: center;
    margin-bottom: 22px;
}

.logo {
    width: 72px;
    height: 72px;
    margin: auto;
    border-radius: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg,#00eaff,#755cff);
    box-shadow: 0 0 30px rgba(0,220,255,.35);
    font-size: 30px;
    font-weight: 900;
}

h1 {
    margin-top: 13px;
    font-size: 26px;
}

.subtitle {
    color: #8e9bb7;
    margin-top: 6px;
    font-size: 13px;
}

.status {
    margin: 18px 0;
    padding: 13px;
    border-radius: 14px;
    background: rgba(255,255,255,.055);
    border: 1px solid rgba(255,255,255,.08);
    text-align: center;
}

.status-dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #777;
    margin-right: 7px;
}

.status.active .status-dot {
    background: #00ff9d;
    box-shadow: 0 0 12px #00ff9d;
}

.card {
    background: rgba(15,20,34,.88);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 20px;
    padding: 10px;
    box-shadow: 0 15px 45px rgba(0,0,0,.3);
}

.feature {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 12px;
    border-bottom: 1px solid rgba(255,255,255,.06);
}

.feature:last-child {
    border-bottom: none;
}

.info {
    display: flex;
    align-items: center;
    gap: 12px;
}

.icon {
    width: 42px;
    height: 42px;
    border-radius: 13px;
    background: rgba(0,220,255,.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #00eaff;
    font-size: 18px;
}

.name {
    font-weight: 700;
    font-size: 15px;
}

.desc {
    color: #707c97;
    font-size: 11px;
    margin-top: 4px;
}

.switch {
    width: 54px;
    height: 31px;
    border: none;
    border-radius: 20px;
    background: #303747;
    position: relative;
    cursor: pointer;
    transition: .25s;
}

.switch::after {
    content: "";
    position: absolute;
    width: 25px;
    height: 25px;
    left: 3px;
    top: 3px;
    border-radius: 50%;
    background: #fff;
    transition: .25s;
}

.switch.on {
    background: #00d99b;
    box-shadow: 0 0 15px rgba(0,255,160,.3);
}

.switch.on::after {
    left: 26px;
}

.toast {
    position: fixed;
    left: 50%;
    bottom: 25px;
    transform: translate(-50%, 120px);
    width: calc(100% - 30px);
    max-width: 450px;
    padding: 14px 17px;
    border-radius: 15px;
    background: #171d2d;
    border: 1px solid rgba(255,255,255,.1);
    box-shadow: 0 15px 40px rgba(0,0,0,.45);
    text-align: center;
    opacity: 0;
    transition: .3s;
    z-index: 999;
}

.toast.show {
    transform: translate(-50%, 0);
    opacity: 1;
}

.toast.success {
    border-color: rgba(0,255,157,.35);
}

.toast.off {
    border-color: rgba(255,80,100,.35);
}

.footer {
    text-align: center;
    margin-top: 20px;
    color: #59647b;
    font-size: 11px;
}
</style>
</head>

<body>

<div class="container">

    <div class="header">
        <div class="logo">ND</div>
        <h1>Aimlock Nguyendat</h1>
        <div class="subtitle">Gaming Configuration Panel</div>
    </div>

    <div class="status" id="globalStatus">
        <span class="status-dot"></span>
        <span id="statusText">Hệ thống đang tắt</span>
    </div>

    <div class="card" id="featureList"></div>

    <div class="footer">
        Aimlock Nguyendat • Configuration Panel
    </div>

</div>

<div class="toast" id="toast"></div>

<script>

const features = [
    {
        id: "antiband",
        name: "ANTIBAND",
        desc: "Trạng thái bảo vệ kết nối"
    },
    {
        id: "fixlag",
        name: "Fix Lag",
        desc: "Tối ưu trạng thái kết nối"
    },
    {
        id: "headshot",
        name: "Fix Nổ Đầu",
        desc: "Cấu hình hỗ trợ headshot"
    },
    {
        id: "crosshair",
        name: "Fix Đúng Tâm",
        desc: "Ổn định tâm ngắm"
    },
    {
        id: "lockhead",
        name: "Bám Đầu",
        desc: "Chế độ hỗ trợ ngắm"
    },
    {
        id: "fps",
        name: "Tăng FPS",
        desc: "Chế độ tối ưu hiệu năng"
    },
    {
        id: "sensitivity",
        name: "Tăng Nhạy",
        desc: "Điều chỉnh độ nhạy"
    }
];

const states = {};

features.forEach(feature => {
    states[feature.id] = false;
});

const list = document.getElementById("featureList");

features.forEach(feature => {

    const row = document.createElement("div");
    row.className = "feature";

    row.innerHTML = `
        <div class="info">
            <div class="icon">⚡</div>
            <div>
                <div class="name">${feature.name}</div>
                <div class="desc">${feature.desc}</div>
            </div>
        </div>

        <button
            class="switch"
            id="switch-${feature.id}"
            aria-label="${feature.name}">
        </button>
    `;

    list.appendChild(row);

    document
        .getElementById(`switch-${feature.id}`)
        .addEventListener("click", () => toggleFeature(feature.id));
});

function toggleFeature(id) {

    states[id] = !states[id];

    const feature = features.find(x => x.id === id);
    const button = document.getElementById(`switch-${id}`);

    if (states[id]) {

        button.classList.add("on");

        showToast(
            "✓ " + feature.name + " đã BẬT",
            true
        );

    } else {

        button.classList.remove("on");

        showToast(
            "× " + feature.name + " đã TẮT",
            false
        );
    }

    updateGlobalStatus();
}

function updateGlobalStatus() {

    const active = Object.values(states).some(Boolean);

    const status = document.getElementById("globalStatus");
    const text = document.getElementById("statusText");

    if (active) {

        status.classList.add("active");
        text.textContent = "Hệ thống đang hoạt động";

    } else {

        status.classList.remove("active");
        text.textContent = "Hệ thống đang tắt";
    }
}

let toastTimer;

function showToast(message, success) {

    const toast = document.getElementById("toast");

    toast.textContent = message;

    toast.className = "toast show " +
        (success ? "success" : "off");

    clearTimeout(toastTimer);

    toastTimer = setTimeout(() => {
        toast.classList.remove("show");
    }, 2200);
}

</script>

</body>
</html>